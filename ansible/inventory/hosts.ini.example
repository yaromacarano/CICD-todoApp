[jenkins_controller]
jenkins-controller ansible_host=172.31.0.11

[jenkins_agents]
jenkins-agent ansible_host=172.31.0.12

[sonarqube]
sonarqube-server ansible_host=172.31.0.13

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/todo-app-key.pem
ansible_python_interpreter=/usr/bin/python3
